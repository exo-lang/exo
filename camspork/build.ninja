rule cxx
  command = python3 cxx.py -fdiagnostics-color=always -g -O2 -Wall -Wextra -Wconversion -Wno-sign-conversion -fPIC -g -std=c++17 $in -c -o $out -MD -MF $out.d
  depfile = $out.d

rule link_lib
  command = python3 cxx.py $in -shared -o $out

build libcamspork/bin/util/require.o: cxx libcamspork/util/require.cpp
build libcamspork/bin/syncv/syncv_table.o: cxx libcamspork/syncv/syncv_table.cpp
build libcamspork/bin/syncv/vis_record_history_log.o: cxx libcamspork/syncv/vis_record_history_log.cpp
build libcamspork/bin/program/builder.o: cxx libcamspork/program/builder.cpp
build libcamspork/bin/program/camspork_excut.o: cxx libcamspork/program/camspork_excut.cpp
build libcamspork/bin/program/exec.o: cxx libcamspork/program/exec.cpp
build libcamspork/bin/program/grammar.o: cxx libcamspork/program/grammar.cpp
build libcamspork/bin/program/print.o: cxx libcamspork/program/print.cpp

build src/camspork/libcamspork.so: link_lib $
    libcamspork/bin/util/require.o $
    libcamspork/bin/syncv/syncv_table.o $
    libcamspork/bin/syncv/vis_record_history_log.o $
    libcamspork/bin/program/builder.o $
    libcamspork/bin/program/camspork_excut.o $
    libcamspork/bin/program/exec.o $
    libcamspork/bin/program/grammar.o $
    libcamspork/bin/program/print.o
    
